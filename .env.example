# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# Deepgram STT
DEEPGRAM_API_KEY=your_deepgram_api_key

# Cartesia TTS
CARTESIA_API_KEY=your_cartesia_api_key
# Find voice IDs at https://play.cartesia.ai/voices
CARTESIA_VOICE_ID_EN=a0e99841-438c-4a64-b679-ae501e7d6091
CARTESIA_VOICE_ID_FR=bf991597-6c13-47e4-8411-91ec2de5c466
CARTESIA_MODEL_ID=sonic-2

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Database (SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite+aiosqlite:///./callcenter.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/callcenter

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=https://your-ngrok-url.ngrok.io   # Twilio must reach this
LOG_LEVEL=INFO

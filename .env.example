# ── Security ────────────────────────────────────────────────────────────────
# Set a strong random key for the dashboard. Leave empty to disable auth (dev only).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-here
# Multiple keys (comma-separated, for multiple users/services):
# API_KEYS=key1,key2,key3

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ── Deepgram STT ─────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── Cartesia TTS ─────────────────────────────────────────────────────────────
CARTESIA_API_KEY=your_cartesia_api_key
# Find/clone voices at https://play.cartesia.ai/voices
CARTESIA_VOICE_ID_EN=a0e99841-438c-4a64-b679-ae501e7d6091
CARTESIA_VOICE_ID_FR=bf991597-6c13-47e4-8411-91ec2de5c466
CARTESIA_MODEL_ID=sonic-2

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (dev/small deployments):
DATABASE_URL=sqlite+aiosqlite:///./callcenter.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/callcenter

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
# IMPORTANT: Twilio must be able to reach this URL (use ngrok for local dev)
BASE_URL=https://your-domain-or-ngrok-url.ngrok.io
LOG_LEVEL=INFO
ENVIRONMENT=development   # set to "production" to tighten CORS
